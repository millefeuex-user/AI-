# Runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=5173
MOCK_MODE=false

# Keep this stable across deploys. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_random_64_char_hex_string

# Set true when the app is accessed through HTTPS, including behind Nginx/Caddy.
COOKIE_SECURE=true

# Feishu OAuth
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_REDIRECT_URI=https://your-domain.example.com/auth/callback
FEISHU_OAUTH_SCOPES=

# Feishu bitable
# If the bitable URL is a wiki URL, fill FEISHU_WIKI_TOKEN from /wiki/<token>.
# The backend will resolve obj_token as the bitable app_token.
FEISHU_WIKI_TOKEN=wikcnxxx
FEISHU_APP_TOKEN=

# Source table IDs
FEISHU_TABLE_LEADER=tblxxx
FEISHU_TABLE_TEAM=tblxxx
FEISHU_TABLE_TD=tblxxx
FEISHU_TABLE_PX_GP=tblxxx
FEISHU_TABLE_SG=tblxxx
FEISHU_TABLE_FI_RA=tblxxx
FEISHU_TABLE_PD_UX=tblxxx
FEISHU_TABLE_OC=tblxxx
FEISHU_TABLE_FC=tblxxx
FEISHU_TABLE_HR_AD_MUXI=tblxxx

# Score result table ID
FEISHU_RESULT_TABLE_ID=tblxxx

# Test safety: default false means bitable reads require user_access_token.
ALLOW_TENANT_TOKEN_FALLBACK=false

# Optional result table field names.
RESULT_ID_FIELD=评分ID
RESULT_ASSIGNMENT_ID_FIELD=关系ID
RESULT_TOPIC_ID_FIELD=课题ID
RESULT_REVIEWER_ID_FIELD=评委UserID
RESULT_REVIEWER_NAME_FIELD=评委姓名
RESULT_REVIEWER_IDENTITY_FIELD=评分人身份
RESULT_TOPIC_GROUP_FIELD=被评项目所在组
RESULT_REVIEW_TYPE_FIELD=评分类型
RESULT_PROBLEM_VALUE_FIELD=问题价值
RESULT_USAGE_DEPTH_FIELD=使用深度
RESULT_DELIVERY_QUALITY_FIELD=交付质量
RESULT_REUSE_ASSET_FIELD=可复用沉淀
RESULT_TOTAL_FIELD=总分
RESULT_GRADE_FIELD=等级
RESULT_COMMENT_FIELD=综合评语
RESULT_HIGHLIGHTS_FIELD=主要亮点
RESULT_SUGGESTIONS_FIELD=改进建议
RESULT_RECOMMEND_CASE_FIELD=是否推荐优秀案例
RESULT_SUBMITTED_AT_FIELD=提交时间

# Optional source-table writeback field names.
WRITEBACK_PEER_AVERAGE_FIELD=互评平均分
WRITEBACK_SUPERVISOR_AVERAGE_FIELD=负责人平均分
WRITEBACK_COMMITTEE_AVERAGE_FIELD=班委平均分
WRITEBACK_SECOND_AVERAGE_FIELD=负责人/班委平均分
WRITEBACK_FINAL_SCORE_FIELD=最终总分
WRITEBACK_FINAL_GRADE_FIELD=最终等级
WRITEBACK_SCORED_COUNT_FIELD=已评分人数
WRITEBACK_STATUS_FIELD=评分状态
WRITEBACK_SCORE_DETAIL_FIELD=评分明细
WRITEBACK_LAST_SCORED_AT_FIELD=最后评分时间
