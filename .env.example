# Server
PORT=5173
MOCK_MODE=true

# Feishu app
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Feishu bitable
# If your bitable URL is a wiki URL, fill FEISHU_WIKI_TOKEN from /wiki/<token>.
# The backend will resolve obj_token as the bitable app token.
FEISHU_WIKI_TOKEN=
FEISHU_APP_TOKEN=bascnxxx
FEISHU_TOPIC_TABLE_ID=tblxxx
FEISHU_ASSIGNMENT_TABLE_ID=tblxxx
FEISHU_RESULT_TABLE_ID=tblxxx

# Optional: change field names if your bitable columns are different.
TOPIC_ID_FIELD=课题ID
TOPIC_NAME_FIELD=课题名称
TOPIC_TYPE_FIELD=课题类型
TOPIC_OWNER_FIELD=提交人/团队
TOPIC_DEPARTMENT_FIELD=所属部门
TOPIC_LEVEL_FIELD=申请等级
TOPIC_MATERIAL_URL_FIELD=材料链接
TOPIC_PRODUCT_URL_FIELD=产品链接
TOPIC_SUMMARY_FIELD=课题摘要

ASSIGNMENT_ID_FIELD=关系ID
ASSIGNMENT_TOPIC_ID_FIELD=课题ID
ASSIGNMENT_REVIEWER_ID_FIELD=评委UserID
ASSIGNMENT_REVIEWER_OPEN_ID_FIELD=评委OpenID
ASSIGNMENT_REVIEWER_NAME_FIELD=评委姓名
ASSIGNMENT_REVIEW_TYPE_FIELD=评分类型
ASSIGNMENT_REQUIRED_FIELD=是否必评

RESULT_ID_FIELD=评分ID
RESULT_ASSIGNMENT_ID_FIELD=关系ID
RESULT_TOPIC_ID_FIELD=课题ID
RESULT_REVIEWER_ID_FIELD=评委UserID
RESULT_REVIEWER_NAME_FIELD=评委姓名
RESULT_PROBLEM_VALUE_FIELD=问题价值
RESULT_USAGE_DEPTH_FIELD=使用深度
RESULT_DELIVERY_QUALITY_FIELD=交付质量
RESULT_REUSE_ASSET_FIELD=可复用沉淀
RESULT_TOTAL_FIELD=总分
RESULT_GRADE_FIELD=等级
RESULT_COMMENT_FIELD=综合评语
RESULT_HIGHLIGHTS_FIELD=主要亮点
RESULT_SUGGESTIONS_FIELD=改进建议
RESULT_RECOMMEND_CASE_FIELD=是否推荐优秀案例
RESULT_SUBMITTED_AT_FIELD=提交时间
